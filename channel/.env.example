# channel-hub configuration.
# Copy to .env and fill in. Keep the real file at chmod 600 — it holds the
# Billz integration key.

NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# Same database as the bot backend. This service only writes its own
# collections (billzproducts, billztokens, synclogs) — enforced in src/db.js.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=fairhaven

# Billz 2.0 (app.billz.io). NOT the Billz 1.0 host at api.billz.uz.
BILLZ_BASE_URL=https://api-admin.billz.ai
BILLZ_SECRET_TOKEN=
BILLZ_SHOP_ID=
BILLZ_CASHBOX_ID=
# Payment type every channel sale is recorded under — Medicalka, Uzum and the
# bot alike. Not cash: a marketplace settles by transfer, and booking it as cash
# corrupts the till reconciliation rather than just mislabelling a row.
#
# «Баланс поставщика» was chosen deliberately over adding a new type per
# channel. The consequence is worth knowing: Billz reports grouped by payment
# type will show one figure for all channels together. What separates them is
# the order comment, which carries the channel and their order id — so a single
# order is always traceable, but "how much did Uzum bring in this month" is a
# question for our own panel, not a Billz report.
#
# The list comes from GET /v1/company-payment-type — note that the documented
# /v1/payment-type is a different endpoint and is forbidden for this key.
# As of 01.08.2026:
#   42bb647e-9533-4104-a018-8fd79e8387b3  Баланс поставщика   ← in use
#   a4f7e08b-0989-4d5b-b00f-9014b2afb2ba  Наличные  [cash]
#   f8bc5726-e398-4359-a83c-598ed17cef8f  Карта
#   175e8f45-279c-40fa-bb55-03ec4517e349  UzCard
#   f9807b06-4ad3-4d8c-8d4d-6816f7c34c77  HUMO
#   9c0d7fce-308a-4d45-8fd3-c0b361bcb4d0  VISA
#   23f7b612-90aa-4634-8327-67e9fe571bab  Mastercard
#   59c7e634-6323-47a6-a733-5edd71c910c8  Certificate
#   e250a85f-3e06-43c0-a164-710b993ac2b1  Voucher
#   e2cd97bb-839b-48ea-abcb-9fe8c9f95577  UnionPay
BILLZ_PAYMENT_TYPE_ID=42bb647e-9533-4104-a018-8fd79e8387b3
BILLZ_PAYMENT_TYPE_NAME=Баланс поставщика

# Billz permits 2 req/s per IP and blocks bursty callers heuristically.
BILLZ_RPS=1.5
BILLZ_PAGE_SIZE=100
BILLZ_TIMEOUT_MS=20000

# Writing sales into Billz. Leave off until the integration key has the order
# methods enabled and the reserve/sale flow has been tested.
BILLZ_WRITE_ENABLED=false

# Shared with the bot backend so the admin panel can trigger a sync. Must match
# CHANNEL_INTERNAL_TOKEN in backend/.env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHANNEL_INTERNAL_TOKEN=

# ── Uzum Tezkor ─────────────────────────────────────────────────────────────
# Off until the integration has been agreed with them. All four values are
# required when it is on; the service refuses to start otherwise.
UZUM_ENABLED=false
# Their identifier for our branch, from the Uzum manager.
UZUM_STORE_ID=
# Signs the bearer tokens we issue. 32+ characters, unique to this deployment.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
UZUM_TOKEN_SIGNING_KEY=
# Public origin the product images are served from. Billz forbids serving media
# from their CDN, so channels are only ever given ours.
PUBLIC_IMAGE_BASE_URL=https://fairhaven.uz
# Where the bot backend writes uploads. Read-only, and only to hash them.
# UPLOADS_DIR=/var/www/fairhaven/backend/uploads

# Tax classification code sent to Uzum when a product has none of its own.
# The panel can override this per product.
DEFAULT_MXIK_CODE=02106999028000000

# ── Bot orders ──────────────────────────────────────────────────────────────
# How long a bot order awaiting confirmation in Telegram keeps its stock out of
# the marketplaces. The order stays open past this — only the protection lapses.
BOT_HOLD_TTL_MS=7200000
BOT_HOLD_SWEEP_MS=60000

# ── Telegram order cards ────────────────────────────────────────────────────
# Marketplace orders never pass through the bot, so this service posts their
# cards itself and edits them as the status changes. Outbound only: no webhook,
# no callbacks, nothing here can be driven from Telegram.
# Same values as the bot backend.
TELEGRAM_BOT_TOKEN=
ORDERS_CHANNEL_ID=
CHANNEL_TELEGRAM_ENABLED=true

SYNC_INTERVAL_MS=300000
SYNC_ON_BOOT=true
# Reject a sync that returns less than this fraction of the mirrored catalogue.
SYNC_MIN_CATALOG_RATIO=0.5

# LOG_LEVEL=debug
