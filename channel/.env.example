# channel-hub configuration.
# Copy to .env and fill in. Keep the real file at chmod 600 — it holds the
# Billz integration key.

NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# Same database as the bot backend. This service only writes its own
# collections (billzproducts, billztokens, synclogs) — enforced in src/db.js.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=fairhaven

# Billz 2.0 (app.billz.io). NOT the Billz 1.0 host at api.billz.uz.
BILLZ_BASE_URL=https://api-admin.billz.ai
BILLZ_SECRET_TOKEN=
BILLZ_SHOP_ID=
BILLZ_CASHBOX_ID=
# Payment type channel sales are recorded under (a transfer, not cash).
# List the real ids with GET /v1/payment-type once the key has permission.
BILLZ_PAYMENT_TYPE_ID=

# Billz permits 2 req/s per IP and blocks bursty callers heuristically.
BILLZ_RPS=1.5
BILLZ_PAGE_SIZE=100
BILLZ_TIMEOUT_MS=20000

# Writing sales into Billz. Leave off until the integration key has the order
# methods enabled and the reserve/sale flow has been tested.
BILLZ_WRITE_ENABLED=false

# Shared with the bot backend so the admin panel can trigger a sync. Must match
# CHANNEL_INTERNAL_TOKEN in backend/.env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHANNEL_INTERNAL_TOKEN=

# ── Bot orders ──────────────────────────────────────────────────────────────
# How long a bot order awaiting confirmation in Telegram keeps its stock out of
# the marketplaces. The order stays open past this — only the protection lapses.
BOT_HOLD_TTL_MS=7200000
BOT_HOLD_SWEEP_MS=60000

# ── Telegram order cards ────────────────────────────────────────────────────
# Marketplace orders never pass through the bot, so this service posts their
# cards itself and edits them as the status changes. Outbound only: no webhook,
# no callbacks, nothing here can be driven from Telegram.
# Same values as the bot backend.
TELEGRAM_BOT_TOKEN=
ORDERS_CHANNEL_ID=
CHANNEL_TELEGRAM_ENABLED=true

SYNC_INTERVAL_MS=300000
SYNC_ON_BOOT=true
# Reject a sync that returns less than this fraction of the mirrored catalogue.
SYNC_MIN_CATALOG_RATIO=0.5

# LOG_LEVEL=debug
