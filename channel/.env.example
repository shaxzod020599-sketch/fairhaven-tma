# channel-hub configuration.
# Copy to .env and fill in. Keep the real file at chmod 600 — it holds the
# Billz integration key.

NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# Same database as the bot backend. This service only writes its own
# collections (billzproducts, billztokens, synclogs) — enforced in src/db.js.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=fairhaven

# Billz 2.0 (app.billz.io). NOT the Billz 1.0 host at api.billz.uz.
BILLZ_BASE_URL=https://api-admin.billz.ai
BILLZ_SECRET_TOKEN=
BILLZ_SHOP_ID=
BILLZ_CASHBOX_ID=

# Billz permits 2 req/s per IP and blocks bursty callers heuristically.
BILLZ_RPS=1.5
BILLZ_PAGE_SIZE=100
BILLZ_TIMEOUT_MS=20000

# Writing sales into Billz. Leave off until the integration key has the order
# methods enabled and the reserve/sale flow has been tested.
BILLZ_WRITE_ENABLED=false

# Shared with the bot backend so the admin panel can trigger a sync. Must match
# CHANNEL_INTERNAL_TOKEN in backend/.env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHANNEL_INTERNAL_TOKEN=

SYNC_INTERVAL_MS=300000
SYNC_ON_BOOT=true
# Reject a sync that returns less than this fraction of the mirrored catalogue.
SYNC_MIN_CATALOG_RATIO=0.5

# LOG_LEVEL=debug
