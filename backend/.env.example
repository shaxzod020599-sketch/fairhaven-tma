# Backend configuration. Copy to .env and fill in; keep the real file chmod 600.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

MONGO_URI=mongodb://127.0.0.1:27017

# Public origin of the mini app. Also decides whether the session cookie gets
# the Secure flag, so an https value here matters even if NODE_ENV is unset.
FRONTEND_URL=https://mini.fairhaven.uz

TELEGRAM_BOT_TOKEN=
ORDERS_CHANNEL_ID=
ADMIN_TELEGRAM_IDS=
WEB_JWT_SECRET=
SUPPORT_PHONE=

# ── Telegram transport ──────────────────────────────────────────────────────
# Egress from this host to api.telegram.org fails often, and long polling
# depends on it continuously. A webhook reverses the direction. If setup fails
# the bot falls back to polling on its own, so this is safe to switch on.
#
# The domain must already terminate TLS and proxy to this process.
# The secret is what authenticates each update — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_DOMAIN=mini.fairhaven.uz
TELEGRAM_WEBHOOK_SECRET=

# ── Stock automation ────────────────────────────────────────────────────────
# Keeps isAvailable in step with Billz stock, approval and images. Leave off
# until the catalogue has been linked: run `node scripts/link-billz.js` and then
# `node scripts/reconcile-stock.js` to see what would change before enabling.
STOCK_RECONCILE_ENABLED=false
STOCK_RECONCILE_MS=120000

# Lets the admin panel ask channel-hub to sync now. Must match
# CHANNEL_INTERNAL_TOKEN in channel/.env.
CHANNEL_HUB_URL=http://127.0.0.1:3100
CHANNEL_INTERNAL_TOKEN=

# ── Billz bridge (bot orders → Billz) ───────────────────────────────────────
# Carries bot and mini-app orders into Billz through the channel hub: a pending
# order takes a local hold, a confirmed one reserves, a delivered one sells, a
# cancelled one releases.
#
# BILLZ_BRIDGE_SINCE is a hard floor — orders created before it are never
# looked at. Set it to the moment you switch the bridge on, or turning it on
# will push the entire order history into Billz as fresh reservations.
# Both variables are required; either one missing keeps the bridge off.
BILLZ_BRIDGE_ENABLED=false
BILLZ_BRIDGE_SINCE=
BILLZ_BRIDGE_INTERVAL_MS=20000

# ── Rate limits (per IP unless noted) ───────────────────────────────────────
# RATE_LIMIT_API_MAX=600      # per 5 minutes
# RATE_LIMIT_AUTH_MAX=30      # per 5 minutes
# RATE_LIMIT_UPLOAD_MAX=60    # per hour, per admin

# ── Development only ────────────────────────────────────────────────────────
# SEED_ON_EMPTY=true          # populate a fresh database with the sample catalogue
# ALLOW_IN_MEMORY_DB=true     # refuses to run when NODE_ENV=production
# DISABLE_CSP=true
# DISABLE_RATE_LIMIT=true
